{
  "name": "@zorya/search",
  "version": "0.1.1",
  "description": "Portable search, retrieval, and indexing core for Zorya services",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist/**",
    "LICENSE",
    "README.md",
    "AGENTS.md",
    "docs/cli.md",
    "docs/sdk.md",
    "docs/mcp.md",
    "docs/voyage-profiles.md",
    "docs/agent-clients.md",
    "docs/architecture.md",
    "skills/**",
    ".agents/rules/**",
    ".cursor/rules/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./code": {
      "types": "./dist/code/index.d.ts",
      "import": "./dist/code/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js"
    },
    "./context/web": {
      "types": "./dist/context/web.d.ts",
      "import": "./dist/context/web.js"
    },
    "./context/classify": {
      "types": "./dist/context/classify.d.ts",
      "import": "./dist/context/classify.js"
    },
    "./visual": {
      "types": "./dist/visual/index.d.ts",
      "import": "./dist/visual/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./daemon": {
      "types": "./dist/daemon/index.d.ts",
      "import": "./dist/daemon/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:node24": "node scripts/test-node24.mjs",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "htmlparser2": "12.0.0",
    "ignore": "7.0.14",
    "typescript": "5.9.3",
    "zod": "4.6.6",
    "jose": "6.2.14"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@electric-sql/pglite-pgvector": "0.0.15",
    "pg": "8.16.3",
    "pdfjs-dist": "5.4.624"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "zorya-search": "./dist/cli/entry.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zoomplus/zorya-search.git"
  },
  "homepage": "https://github.com/zoomplus/zorya-search",
  "bugs": {
    "url": "https://github.com/zoomplus/zorya-search/issues"
  }
}
